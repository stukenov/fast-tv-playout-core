# Database
DATABASE_URL=postgres://user:password@localhost:5432/fast

# Redis
REDIS_URL=redis://localhost:6379

# S3/Object Storage
S3_BUCKET=my-fast-content
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Playout Configuration
SEGMENT_DURATION=2
PLAYLIST_WINDOW=90

# API
API_PORT=8080

# Monitoring
PROMETHEUS_PORT=9090
METRICS_ENABLED=true

# Logging
LOG_LEVEL=info

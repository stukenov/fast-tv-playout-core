# Copy to .env, docker compose reads it automatically.

# --- required ---------------------------------------------------------------
# Key for the HTTP APIs (header X-API-Key). Generate: openssl rand -hex 24
API_KEY=
POSTGRES_PASSWORD=

# --- optional ---------------------------------------------------------------
# More keys with limited rights: name=secret:scopes:channels, separated by ";".
# Scopes: read, schedule, command, admin. Channels: names joined by "+", or "*".
# The secret may be given as sha256:<hex of the SHA-256 of the secret>.
#   API_KEYS=ops=SECRET_OF_OPS:schedule+command+read:c1;viewer=SECRET_OF_VIEWER:read:*
API_KEYS=

LOG_LEVEL=info
CHANNEL_ID=c1

# Where the engine learns what is on the air: webhook receivers "url|secret;url|secret".
# Every request carries X-FTVX-Signature: sha256=<HMAC-SHA256 of the body with the secret>.
WEBHOOK_URLS=

# Ads: an ad server that is asked for every break (see api/openapi.yaml, x-ads-webhook),
# or, when it is empty, a registry file in MEDIA_DIR (see README). Without both a break is filled with slate.
ADS_URL=
ADS_API_KEY=

# How an ad break is marked in the playlist: daterange (EXT-X-DATERANGE with SCTE-35), cue (EXT-X-CUE-OUT/IN), both or off.
SCTE35_TAGS=daterange

# How soon a command can reach the air: CUE_LEAD_S (control-api) plus LIVE_LEAD_S (engine).
CUE_LEAD_S=3
LIVE_LEAD_S=6

# Folder with your sources: the engine reads it as /media (file:///media/...). Layout: see README.
MEDIA_DIR=./media

# These go into master.m3u8 and must describe your sources:
VARIANT_ID=v720
VARIANT_BANDWIDTH=3000000
VARIANT_AVERAGE_BANDWIDTH=2700000
VARIANT_RESOLUTION=1280x720
VARIANT_FRAME_RATE=25
VARIANT_CODECS=avc1.640029,mp4a.40.2
